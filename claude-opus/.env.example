# Copy to `.env` and fill in. TxtTattler loads this automatically.

# --- Standard OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# --- Azure OpenAI (use with --azure, or it auto-enables if ENDPOINT is set) ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT_ID=tts
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
